# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Replicate (hosts google/gemini-3.1-pro and many other LLMs) ---
# Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...
REPLICATE_MODEL=google/gemini-3.1-pro

# --- Search (Tavily - AI-optimized search) ---
# https://app.tavily.com/  (free 1000 searches/month, no card)
# Leave blank to skip web search (posts will rely on training data only)
TAVILY_API_KEY=tvly-...

# --- Cover images ---
# AI-generated via Replicate Flux Schnell (~$0.003 per image).
# Uses the same REPLICATE_API_TOKEN as the LLM client — no extra env needed.
# Images persist in Supabase Storage in this bucket (must be created and PUBLIC):
COVER_BUCKET=post-covers
# Cover images are generated by openai/gpt-image-2 on Replicate (uses the same
# REPLICATE_API_TOKEN). Quality controls cost: low ≈ cheapest, medium = balanced,
# high = pricey. Inline body images stay on cheap Flux Schnell.
COVER_IMAGE_QUALITY=medium

# --- Cron auth ---
# Vercel injects CRON_SECRET; we require it on /api/cron/*
CRON_SECRET=replace-me-with-random-string

# Optional. The scheduler sizes its generation drain against the route's
# maxDuration (300s). Set this to the plan's REAL function ceiling in ms when
# that's lower — Vercel Hobby kills functions at 60s whatever the route asks
# for — so the drain stops cleanly instead of being killed mid-article.
# Unset on Pro, where maxDuration is honoured.
# GROVE_TICK_BUDGET_MS=60000

# --- App ---
NEXT_PUBLIC_APP_URL=https://trygroveai.com
# Serve each blog on its own subdomain: {blog_slug}.{this}. Requires (1) a
# wildcard DNS record *.{this} pointing at the app and (2) the wildcard domain
# added to the hosting project (e.g. Vercel → Domains → *.grove.so). Leave
# UNSET to serve blogs at {NEXT_PUBLIC_APP_URL}/b/{slug} instead — canonical,
# sitemap, RSS, and social URLs all follow this setting automatically.
GROVE_BLOG_ROOT_DOMAIN=grove.so

# --- Custom blog hostnames (optional) ---
# When a customer sets domains.custom_blog_hostname (blog.acme.com), grove
# attaches it to THIS Vercel project automatically so Vercel routes + issues TLS
# — no manual Domains-tab step. UNSET all three → the auto-attach is a no-op and
# the hostname must be added by hand (the feature still serves once it is).
# Token needs the Domains scope (Account → Settings → Tokens).
VERCEL_API_TOKEN=
# Project id (prj_…) or the project name.
VERCEL_PROJECT_ID=
# Only when the project lives under a team (team/org id).
VERCEL_TEAM_ID=

# --- Social auto-publish (optional) ---
# Encrypts stored OAuth tokens at rest. 32 bytes, hex or base64.
# Generate: openssl rand -hex 32
SOCIAL_TOKEN_KEY=
# Dry-run: when true, auto-share LOGS the exact payload it would post to each
# platform and makes no network call. Use to preview before going live.
SOCIAL_DRY_RUN=false
# Each platform needs an app registered on its developer portal, with the
# redirect URI set to: {NEXT_PUBLIC_APP_URL}/api/social/<platform>/callback
# X (https://developer.x.com) — OAuth2 with tweet.write + offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=
# LinkedIn (https://www.linkedin.com/developers) — needs w_member_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Instagram via Facebook (https://developers.facebook.com) — IG Business acct
# + instagram_content_publish; uses the post's cover image
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Google Search Console (optional) ---
# Lets Grove read impressions/position per page so the strategist can refresh
# near-winners — AND set up the Search Console property for the customer (verify
# the domain + add the property) so onboarding is one DNS record, not a trip
# through the GSC UI.
# In Google Cloud Console: create an OAuth client (type: Web), enable BOTH the
# "Search Console API" and the "Site Verification API", and set the authorized
# redirect URI to:
#   {NEXT_PUBLIC_APP_URL}/api/search-console/callback
# Scopes requested (read + self-serve setup):
#   https://www.googleapis.com/auth/webmasters
#   https://www.googleapis.com/auth/siteverification
# These are "sensitive" scopes — to go past test users, the OAuth consent screen
# needs Google verification.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe billing ---
# 1) Create 3 recurring MONTHLY Products/Prices in the Stripe dashboard:
#      Starter $29 · Growth $79 · Agency $199  → copy each Price id (price_…).
#    Then 3 more recurring YEARLY Prices at the -20% annual rate (lib/plans.ts
#    ANNUAL_DISCOUNT; monthly-equivalent × 12, so it matches what the app shows):
#      Starter $276/yr · Growth $756/yr · Agency $1,908/yr.
#    Easiest: add the yearly price as a second Price on each EXISTING product
#    (Stripe products can hold multiple prices) rather than new products.
# 2) Add a webhook endpoint pointing at {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
#    subscribed to: checkout.session.completed, customer.subscription.created,
#    customer.subscription.updated, customer.subscription.deleted.
#    Copy its signing secret (whsec_…) into STRIPE_WEBHOOK_SECRET.
# 3) Enable the Customer Portal (Stripe → Settings → Billing → Customer portal).
# Secret key — server only, NEVER prefix with NEXT_PUBLIC.
STRIPE_SECRET_KEY=sk_live_or_test_...
# Webhook signing secret — verifies events are really from Stripe.
STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly price ids per plan (must match lib/plans.ts tiers).
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_AGENCY=price_...
# Yearly price ids per plan. Optional — unset means the Annual toggle on
# /dashboard/billing 503s with "plan price not configured" for that tier.
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_GROWTH_YEARLY=price_...
STRIPE_PRICE_AGENCY_YEARLY=price_...

# --- Transactional email (Resend) ---
# Powers the weekly digest AND the refund-request owner notification.
# Without RESEND_API_KEY, sends are no-ops (logged) — the app still works.
# Get a key at https://resend.com; verify your sending domain.
RESEND_API_KEY=re_...
# From address — must be on a Resend-verified domain.
RESEND_FROM=Grove <agent@trygroveai.com>

# --- Refund funnel / admin ---
# Where refund-request notifications are emailed (defaults to the first admin).
GROVE_OWNER_EMAIL=tylee1171@snu.ac.kr
# Comma-separated allow-list of admin emails. Admins see /dashboard/admin/refunds
# and can issue Stripe refunds. Defaults to tylee1171@snu.ac.kr if unset.
GROVE_ADMIN_EMAILS=tylee1171@snu.ac.kr

# --- PostHog (product analytics) ---
# Client + server-side tracking. Both read the same token. Get the project
# token from PostHog → Project Settings → Project API Key. Host is the ingest
# endpoint (https://us.i.posthog.com for the US region / us.posthog.com cloud).
# In production these live in the Vercel dashboard (Settings → Environment
# Variables), not this file — this file is documentation for local dev only.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
