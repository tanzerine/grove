# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Gemini (Google AI Studio - pay-as-you-go) ---
# Get one at https://aistudio.google.com/app/apikey
# Enable billing for Pro models: https://aistudio.google.com/usage
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash   # used for cheap tasks (site profile extraction)

# --- Search (Tavily - AI-optimized search) ---
# https://app.tavily.com/  (free 1000 searches/month, no card)
# Leave blank to skip web search (posts will rely on training data only)
TAVILY_API_KEY=tvly-...

# --- Cron auth ---
# Vercel injects CRON_SECRET; we require it on /api/cron/*
CRON_SECRET=replace-me-with-random-string

# --- App ---
NEXT_PUBLIC_APP_URL=https://app.grove.so
GROVE_BLOG_ROOT_DOMAIN=grove.so   # managed blogs served at <slug>.<this>
