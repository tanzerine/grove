# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- LLM (OpenAI-compatible endpoint - default: Groq free tier) ---
# Groq: https://console.groq.com/keys  (free, no card, ~6k req/day Llama 3.3 70B)
# Alternatives: OpenRouter, Together, DeepSeek, OpenAI - all use same SDK shape
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Search (Tavily - AI-optimized search) ---
# https://app.tavily.com/  (free 1000 searches/month, no card)
# Leave blank to skip web search (posts will rely on training data only)
TAVILY_API_KEY=tvly-...

# --- Cron auth ---
# Vercel injects CRON_SECRET; we require it on /api/cron/*
CRON_SECRET=replace-me-with-random-string

# --- App ---
NEXT_PUBLIC_APP_URL=https://app.grove.so
GROVE_BLOG_ROOT_DOMAIN=grove.so   # managed blogs served at <slug>.<this>
